# Local scratch, fixtures, build output, anything machine-specific.
# One directory instead of a growing list of patterns: new kinds of scratch file are
# safe by default, and "is this safe to share?" has a single answer. See DESIGN.md §12.1.
private_data/

# Runtime data — never commit a live config db, keys, logs, backups, or downloads
config/
downloads/
staging/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/

# Env
.env
.env.*
!.env.example

# Docker — committed: docker-compose.yml, .dev.yml, .test.yml
docker-compose.override.yml

# Claude
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
